{
  "manifest_version": 3,
  "name": "Pall",
  "version": "0.1.0",
  "description": "A private assistant that manages your tasks and shields your browsing from scams, spam, adware and risky sites. Your data stays on your device.",
  "minimum_chrome_version": "114",
  "icons": { "16": "icons/safe-16.png", "32": "icons/safe-32.png", "48": "icons/safe-48.png", "128": "icons/safe-128.png" },
  "action": {
    "default_title": "Open Pall",
    "default_icon": { "16": "icons/safe-16.png", "32": "icons/safe-32.png" }
  },
  "side_panel": { "default_path": "sidepanel/index.html" },
  "background": { "service_worker": "background.js" },
  "permissions": [
    "storage", "activeTab", "scripting", "sidePanel", "tabs", "alarms", "notifications", "contextMenus",
    "management", "webRequest", "declarativeNetRequest", "declarativeNetRequestFeedback"
  ],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    { "matches": ["<all_urls>"], "js": ["content/main_world.js"], "run_at": "document_start", "world": "MAIN", "all_frames": true },
    { "matches": ["<all_urls>"], "js": ["lib/domains.js", "lib/redact.js", "lib/heuristics.js", "content/scan.js"], "run_at": "document_start" }
  ],
  "declarative_net_request": {
    "rule_resources": [
      { "id": "ads", "enabled": true, "path": "rules/ads.json" },
      { "id": "params", "enabled": true, "path": "rules/params.json" },
      { "id": "https", "enabled": false, "path": "rules/https.json" }
    ]
  },
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'self'" }
}
